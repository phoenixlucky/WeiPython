{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WJ Python Manager",
  "version": "3.1.1",
  "identifier": "com.wjpython.manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "WJ Python管理大师",
        "width": 1440,
        "height": 960,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: https://asset.localhost; script-src 'self' 'unsafe-eval'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "../public/assets/installer/app-icon.ico"
    ],
    "windows": {
      "nsis": {
        "headerImage": "../public/assets/installer/installer-header.bmp",
        "sidebarImage": "../public/assets/installer/installer-sidebar.bmp",
        "installerIcon": "../public/assets/installer/app-icon.ico",
        "uninstallerIcon": "../public/assets/installer/app-icon.ico",
        "installMode": "both",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false,
        "startMenuFolder": "WJ Python Manager"
      }
    }
  }
}
